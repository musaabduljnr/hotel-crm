# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Authentication
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=8h

# Supabase (default backend for this app)
USE_SUPABASE_AUTH=true
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legacy MySQL fallback (only used when USE_SUPABASE_AUTH=false)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hotel_crm
DB_POOL_LIMIT=10

# Seed defaults
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@hotelcrm.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!
