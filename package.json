{
  "name": "hotel-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Haven CRM — Hotel Operations & Guest Management System",
  "scripts": {
    "postinstall": "npm --prefix backend install",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend install",
    "start": "npm --prefix backend start",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend start",
    "frontend:dev": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "hotel-crm",
    "guest-management",
    "booking-system",
    "react",
    "express",
    "mysql",
    "supabase"
  ],
  "author": "Musa A. Abubakar",
  "license": "ISC"
}
